{
  "name": "arg-plifting-analysis",
  "version": "1.0.0",
  "private": true,
  "description": "Análisis descriptivo de powerlifting argentino sobre BigQuery (Capa 01)",
  "scripts": {
    "test": "npm run test:js && npm run test:py",
    "test:js": "node --test tests/frontend/*.test.mjs",
    "test:py": ".venv\\Scripts\\python.exe -m pytest tests/ -q",
    "refresh": ".venv\\Scripts\\python.exe scripts/refresh_data.py",
    "refresh:dry": ".venv\\Scripts\\python.exe scripts/refresh_data.py --dry-run",
    "check": ".venv\\Scripts\\python.exe scripts/refresh_data.py --check",
    "cohortes": ".venv\\Scripts\\python.exe scripts/cohortes.py",
    "cohortes:dry": ".venv\\Scripts\\python.exe scripts/cohortes.py --dry-run",
    "check:cohortes": ".venv\\Scripts\\python.exe scripts/cohortes.py --check",
    "check:sql": ".venv\\Scripts\\python.exe scripts/check_sql_keys.py",
    "check:libreto": ".venv\\Scripts\\python.exe scripts/check_libreto.py",
    "verify:tests": ".venv\\Scripts\\python.exe scripts/verificar_tests.py",
    "verify:deploy": "bash scripts/verify_deploy.sh",
    "serve": "python -m http.server 8899 --bind 127.0.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
